<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Examples</RootNamespace>
    <AssemblyName>Examples</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Prevent SDK from generating assembly attributes (we ship Properties/AssemblyInfo.cs) -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- The SDK includes all .cs files in the project directory by default; no explicit Compile items required. -->

  <ItemGroup>
    <None Include="app.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AltaPayApi/AltaPayApi.csproj" />
  </ItemGroup>

  <!-- Exclude example files that depend on NUnit or other test-only files -->
  <ItemGroup>
    <Compile Remove="Service/Example_Klarna.cs" />
    <Compile Remove="Service/Example_Klarna_Capture_UpdateOrder.cs" />
  </ItemGroup>

</Project>
